APP_ENV=development

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentic_layer

REDIS_URL=redis://localhost:6379/0

LLM_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

PII_DETECTION_ENABLED=true
PII_TOKEN_EXPIRY_SECONDS=3600

DEFAULT_DAILY_THRESHOLD=120
SOCIAL_MEDIA_THRESHOLD=60
ENTERTAINMENT_THRESHOLD=90

SECRET_KEY=your-secret-key-here